# Plantilla de configuración del backend (SIN valores reales). Copia a .env.development o
# .env.production y llena lo tuyo. Nunca subas los archivos .env reales al repositorio.

# --- Servidor ---
NODE_ENV=development
PORT=8080
# Orígenes permitidos (panel y tienda), separados por coma.
CORS_ORIGIN=http://localhost:8081,http://localhost:8082

# --- Base de datos (PostgreSQL) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_DIALECT=postgres
# SSL activado salvo "false" (una base local sin SSL necesita DB_SSL=false).
DB_SSL=true
DB_POOL_MAX=5
# true = muestra cada consulta SQL en consola (solo para depurar).
DB_LOG_SQL=false
# Conexión directa (sin pooler) para respaldos/restauración. En Neon se deduce sola quitando
# "-pooler" del host; defínela solo si usas otro proveedor con pooler.
DB_HOST_DIRECTO=

# --- Sesiones ---
JWT_SECRET=
JWT_EXPIRES_IN=86400

# --- Pagos con tarjeta (Stripe). La clave secreta NUNCA va en el frontend. ---
# sk_test_clave_de_prueba_universidad = modo simulado (cobros aprobados al instante).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Fotos (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Correos a clientas (pedido pagado/enviado/entregado/cancelado, devoluciones, reembolsos,
#     «olvidé mi contraseña»). Sin SMTP_HOST no se envía nada (solo se muestra en consola). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Distribuidora <no-responder@tu-dominio.com>
# Dirección pública de la tienda: los enlaces de los correos apuntan aquí.
TIENDA_URL=http://localhost:8082
# smtp | consola | archivo (archivo: guarda cada correo como JSON en CORREO_CARPETA; lo usan las pruebas).
CORREO_MODO=
CORREO_CARPETA=

# --- Reglas del negocio ---
# Horas desde la entrega para pedir un cambio o una devolución (una sola solicitud por pedido).
HORAS_PLAZO_DEVOLUCION=24
# Horas para pagar un pedido pendiente antes de que se cancele solo (0 = nunca).
PLAZO_PEDIDO_PENDIENTE_HORAS=24
# Cada cuántos minutos se revisan pedidos vencidos y reembolsos a tarjeta pendientes.
VENCIMIENTO_INTERVALO_MIN=10
# Envío a domicilio de la tienda en línea y monto (después del descuento) desde el que es gratis (0 = nunca gratis).
ENVIO_COSTO=25
ENVIO_GRATIS_DESDE=300
# IVA incluido en los precios (se desglosa en pedidos y reportes).
IVA_PORCENTAJE=12
ZONA_HORARIA_NOMBRE=America/Guatemala
ZONA_HORARIA_TIENDA=-06:00

# --- Monitoreo (opcional) ---
# Con un DSN de Sentry los errores también se envían allá (requiere: npm install @sentry/node).
SENTRY_DSN=

# --- Respaldos (npm run respaldo / npm run restaurar) ---
# Carpeta bin de PostgreSQL si pg_dump no está en el PATH (en Windows se busca sola).
PG_BIN=
RESPALDOS_DIR=
RESPALDOS_MAX=14
